              "raw": "{\n  \"clienteId\": 4,\n  \"direccionOrigenId\": 8,\n  \"direccionDestinoId\": 8,\n  \"destinatario\": \"X\",\n  \"costoTotal\": 100,\n  \"paquetes\": [\n    {\n      \"peso\": 1,\n      \"dimensiones\": \"10x10x10 cm\",\n      \"contenido\": \"Prueba\"\n    }\n  ]\n}",
